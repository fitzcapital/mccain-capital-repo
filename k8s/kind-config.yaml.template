kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: mccain-capital
nodes:
  - role: control-plane
    extraPortMappings:
      - containerPort: 30001
        hostPort: 5001
        listenAddress: "127.0.0.1"
        protocol: TCP
    extraMounts:
      - hostPath: __PERSISTENT_DATA_PATH__
        containerPath: /mnt/mccain-capital-data
        readOnly: false
