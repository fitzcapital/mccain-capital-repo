{
  "rules": [
    {
      "name": "Bank Alerts",
      "folder": "Review/Bank",
      "from_contains": ["@chase.com", "@americanexpress.com", "@bankofamerica.com"],
      "subject_contains": ["alert", "transaction", "statement", "payment due"]
    },
    {
      "name": "Work",
      "folder": "Review/Work",
      "from_contains": ["@yourcompany.com", "manager@"],
      "subject_contains": ["urgent", "asap", "meeting", "deadline"]
    },
    {
      "name": "Security",
      "folder": "Review/Security",
      "from_contains": ["noreply@", "security@", "support@"],
      "subject_contains": ["password", "2fa", "verification code", "sign-in"]
    }
  ]
}
